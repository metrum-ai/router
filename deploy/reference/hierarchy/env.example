#
# Copy to .env and fill in the CHANGEME values. Nothing here is a Metrum or
# provider secret: the router tokens, the token hashes and the identifier key
# are generated by the deployment. The router expands only the brace form of a
# variable reference, so every value below is required as written.

# --- package images ---------------------------------------------------------
# Pinned router package image (dist/metrum-ai-router-<version>-docker-linux-<arch>.tar.gz).
ROUTER_IMAGE=metrum-ai-router:4.7.0-linux-amd64
PYTHON_IMAGE=python:3.12-slim

# --- network ---------------------------------------------------------------
EDGE_LISTEN_PORT=8080
DC_LISTEN_PORT=8081
# One edge + one datacenter hop, with headroom for a future tier.
MAX_ROUTER_HOPS=4
DC_UPSTREAM_TIMEOUT_MS=480000

# --- identifier transform ---------------------------------------------------
# The router needs 64 bytes: openssl rand -hex 64 (128 hex characters).
ROUTER_ID_TRANSFORM_KEY=CHANGEME_64_BYTE_HEX_KEY
ROUTER_ID_TRANSFORM_KEY_ID=edge-2026-11

# --- usage stores: one database per hop -------------------------------------
POSTGRES_PASSWORD=CHANGEME_PASSWORD
EDGE_USAGE_DRIVER=postgres
EDGE_USAGE_PATH=/var/lib/router/usage.sqlite
EDGE_USAGE_DSN=postgres://router:CHANGEME_PASSWORD@postgres:5432/edge_usage?sslmode=disable
DC_USAGE_DRIVER=postgres
DC_USAGE_PATH=/var/lib/router/usage.sqlite
DC_USAGE_DSN=postgres://router:CHANGEME_PASSWORD@postgres:5432/dc_usage?sslmode=disable

# --- per-tier runtime paths (inside each container) -------------------------
EDGE_STATE_PATH=/var/lib/router/router-state.json
EDGE_LOG_PATH=/var/lib/router/requests.jsonl
DC_STATE_PATH=/var/lib/router/router-state.json
DC_LOG_PATH=/var/lib/router/requests.jsonl

# --- hop wiring -------------------------------------------------------------
DC_ROUTER_URL=http://dc:8080/v1
EDGE_ROUTER_URL=http://edge:8080/v1
# The datacenter tier's token for calling back into the edge (loop check and
# edge-local models). The raw value of the `dc-to-edge` token.
DC_LOOPBACK_TOKEN=CHANGEME_DC_TO_EDGE_TOKEN

# --- edge tier accounts and caller -----------------------------------------
EDGE_OWNER_USER=ops
EDGE_PROJECT=edge-prod
EDGE_ENVIRONMENT=prod
EDGE_CALLER_ID=app
# From `metrum-ai-routerctl callers hash --token-file secrets/app.token`.
EDGE_CALLER_TOKEN_HASH=CHANGEME_PBKDF2_HASH
EDGE_CALLER_TOKEN_ID=rtr_metrum_ops_edge-prod_prod_app
EDGE_CALLER_RPM=600
EDGE_CALLER_TPM=400000
EDGE_CALLER_CONCURRENT=32
EDGE_CALLER_DAY_REQUESTS=0
EDGE_CALLER_DAY_TOKENS=0
EDGE_CALLER_MONTH_TOKENS=0
# The datacenter tier's loopback caller at the edge (the `dc-to-edge` token).
EDGE_LOOPBACK_CALLER_ID=dc-loopback
EDGE_LOOPBACK_TOKEN_HASH=CHANGEME_PBKDF2_HASH
EDGE_LOOPBACK_TOKEN_ID=rtr_metrum_ops_edge-prod_prod_dc-loopback
# The raw value of the `edge-to-dc` token: the edge presents it to the DC.
DC_ROUTER_TOKEN=CHANGEME_EDGE_TO_DC_TOKEN

# --- datacenter tier accounts and caller -----------------------------------
DC_OWNER_USER=ops
DC_PROJECT=dc-prod
DC_ENVIRONMENT=prod
DC_CALLER_ID=edge-router
# From `metrum-ai-routerctl callers hash --token-file secrets/edge-to-dc.token`.
DC_CALLER_TOKEN_HASH=CHANGEME_PBKDF2_HASH
DC_CALLER_TOKEN_ID=rtr_metrum_ops_dc-prod_prod_edge-router
DC_CALLER_RPM=1200
DC_CALLER_TPM=1000000
DC_CALLER_CONCURRENT=64

# --- frontier ---------------------------------------------------------------
# Defaults to the demo fixture so the stack needs no provider credentials.
# For a real deployment set these to a hosted API or a self-hosted vLLM
# endpoint, for example https://api.openai.com/v1 with a real FRONTIER_API_KEY.
FRONTIER_BASE_URL=http://frontier-echo:9100/v1
FRONTIER_API_KEY=demo-no-key
FRONTIER_MODEL=frontier-demo
# Cost-allocation rates for this hop's usage rows (0 = token volume only).
FRONTIER_INPUT_PRICE_USD_PER_MTOK=0
FRONTIER_OUTPUT_PRICE_USD_PER_MTOK=0
FRONTIER_PRICING_SOURCE=deployment-cost-allocation
FRONTIER_PRICING_UPDATED_AT=2026-11-02
