#
# Caddyfile overlay for a local Pebble run: it keeps the DNS-01 flow but trusts
# the test CA and uses its directory. Use it only with the smoke test.
#
#   ROUTER_ACME_CA=https://127.0.0.1:14000/dir \
#   ROUTER_ACME_CA_ROOT=/tmp/pebble/root.pem \
#   caddy run --config Caddyfile --config Caddyfile.pebble

{
	acme_ca {$ROUTER_ACME_CA}
	acme_ca_root {$ROUTER_ACME_CA_ROOT}
}
