{
  "meta": {
    "purpose": "Source of truth for a realistic OpenJev routing decision video. Every on-screen number must come from this file.",
    "date": "2026-09-25",
    "do_not_invent": [
      "model ids",
      "prices",
      "probabilities",
      "latencies",
      "accuracy",
      "prompts"
    ]
  },
  "system": {
    "product": "Metrum AI Router",
    "decision_model": "OpenJev (open weights)",
    "openjev_role": "Chooses task class only. Does not write the user-facing answer. Returns typed choice / score / noul — no free-form text to parse.",
    "router_role": "Owns eligibility, upstream call, usage, latency, fallback. Policy cannot invent targets outside the model group.",
    "hardware": "Shadeform massedcompute RTXPro6000 / NVIDIA RTX PRO 6000 Blackwell Server Edition 97887 MiB / driver 580.126.09 / vLLM 0.29.0 fp8",
    "license": "OpenJev weights CC BY-NC 4.0; OpenJev != TypeSafe hosted Jev",
    "pipeline": [
      {
        "step": 1,
        "actor": "client",
        "action": "POST chat/completions to router model group openjev-routing-demo"
      },
      {
        "step": 2,
        "actor": "router",
        "action": "strategy:external — POST eligible targets + trusted request text to policy /route"
      },
      {
        "step": 3,
        "actor": "policy",
        "action": "Build OpenJev state from request text; POST /v1/systemone with three typed questions in one call"
      },
      {
        "step": 4,
        "actor": "openjev",
        "action": "Return answers.task (choice), answers.complexity (score), answers.high_risk (noul). usage.output_tokens=0"
      },
      {
        "step": 5,
        "actor": "policy",
        "action": "Apply escalation rules; map final_task → targetIndex by tier/model id; return classLabel + metadata"
      },
      {
        "step": 6,
        "actor": "router",
        "action": "Call selected OpenAI model; keep fallbackIndexes for fail-closed retries"
      }
    ],
    "openjev_questions": [
      {
        "id": "task",
        "type": "choice",
        "options": ["simple", "medium", "advanced"],
        "means": "What task class is this request?"
      },
      {
        "id": "complexity",
        "type": "score",
        "legend": {
          "0": "trivial",
          "1": "light",
          "2": "moderate",
          "3": "hard",
          "4": "expert"
        },
        "means": "How hard is the work? (used as metadata; not the primary map key)"
      },
      {
        "id": "high_risk",
        "type": "noul",
        "threshold": 0.5,
        "means": "Calibrated P(yes) that this request is high-stakes / high-risk"
      }
    ],
    "policy_rules": [
      {
        "id": "R1_map",
        "rule": "Map OpenJev task choice → priced ladder tier by model id (not array index)"
      },
      {
        "id": "R2_escalate_risk",
        "rule": "If high_risk.noul >= 0.5 → escalate one tier (simple→medium, medium→advanced)"
      },
      {
        "id": "R3_escalate_confidence",
        "rule": "If task.confidence < 0.45 → escalate one tier"
      },
      {
        "id": "R4_fallbacks",
        "rule": "Return higher-tier eligible targets first as fallbackIndexes"
      }
    ],
    "ladder": [
      {
        "task": "simple",
        "tier": "cheap",
        "model": "gpt-5.6-luna",
        "price_per_m_in_out": [0.2, 1.2],
        "sample_avg_latency_ms": 1402
