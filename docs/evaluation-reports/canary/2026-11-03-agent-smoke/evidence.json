{
  "schema": "agent-canary-smoke/v1",
  "date": "2026-11-03",
  "purpose": "AGENT-06 real-client image and reasoning validation (v4.7.0 item of #330), bounded hosted calls",
  "client": {
    "pi": "1.4.0",
    "provider_entry": "metrum (openai-completions, isolated PI_CODING_AGENT_DIR)"
  },
  "router": {
    "mode": "local listener 127.0.0.1:18131, identifiers.mode=passthrough, sqlite usage DB",
    "target_model": "gpt-5.4-nano (OpenAI Chat), input_modalities text+image, tool_support openai_chat tools+tool_choice",
    "task_image_digests": {
      "nonce-image.png": "sha256:2573004112b4fe27bc2786dbbb03cf6605e7bc3bdd903916b38c447a475f4118"
    }
  },
  "runs": [
    {
      "id": "image-reading",
      "command": "pi -p --no-session --provider metrum --model agent-smoke --thinking off --mode json '@nonce2.png' 'What six-digit number is printed in this image? Reply with only the number.'",
      "exit": 0,
      "answer": "739182",
      "expected": "739182",
      "pass": true,
      "note": "the answer exists only inside the image, so the image traversed the router to the upstream"
    },
    {
      "id": "reasoning-only",
      "command": "pi -p --no-session --provider metrum --model agent-smoke --thinking high --no-tools --mode json 'Compute 17*23 + 19*7. Reply with only the integer.'",
      "exit": 0,
      "reasoning_effort_bucket": "high",
      "pass": true,
      "note": "a real client's high reasoning effort reached the upstream through the router (telemetry bucket high)"
    },
    {
      "id": "declared-refusal",
      "command": "pi ... --model agent-smoke-declared (default thinking medium with pi tools)",
      "exit": 0,
      "router_status": 400,
      "code": "unsupported_capability",
      "param": "reasoning_effort",
      "upstream_attempts": 0,
      "pass": true,
      "note": "with reasoning.with_tools: false declared (#703), a real client's reasoning+tools shape on a Chat target fails closed with a typed 4xx and zero upstream calls instead of a provider 400"
    }
  ],
